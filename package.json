{
  "name": "vibentry-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vibentry Telegram Mini App and bot — design-first handoff",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --use-env-proxy --watch server/index.mjs",
    "start": "node --env-file-if-exists=.env --use-env-proxy server/index.mjs",
    "bot": "node --env-file-if-exists=.env --use-env-proxy server/bot.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs"
  }
}
