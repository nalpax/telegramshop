# Server. Never commit a real .env.
HOST=127.0.0.1
PORT=3000

# Set securely on your server; leave empty for design preview.
BOT_TOKEN=
BOT_USERNAME=
# Public HTTPS address of the deployed Mini App. Required for the bot.
APP_URL=
# Public support contact without @. Change if the course author changes.
SUPPORT_USERNAME=nalpax
# Optional support e-mail shown on the document pages.
SUPPORT_EMAIL=
# Optional seller details on the document pages. Empty by default: the pages name only the service administration.
SELLER_STATUS=
SELLER_NAME=
SELLER_INN=

# Fallback only: required channels are managed in the admin panel (Доступ). Used while that list is empty. Bot must be admin.
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_URL=
# Price in whole Telegram Stars. No default price is invented.
PRICE_STARS=
# Starting price in rubles (owner's decision: 1299). The admin panel (Акции) overrides both.
PRICE_RUB=
# Access is ALWAYS a permanent purchase tied to the paying Telegram ID.
# Comma-separated numeric Telegram IDs allowed to edit the offer in the admin screen.
ADMIN_IDS=
DATABASE_PATH=./var/vibentry.sqlite
NODE_ENV=development
# Seconds a positive channel-membership check is reused (reduces getChatMember calls). 0 = always ask Telegram.
MEMBERSHIP_CACHE_SECONDS=60

# ---- Optional payment providers (all OFF until keys are set here AND switched on in the admin panel) ----
# Platega — cards and SBP, RUB. Webhook: {APP_URL}/api/webhooks/platega
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# 2 = SBP QR, 10 = cards RUB, 11 = card acquiring, 12 = international acquiring, 13 = crypto (see Platega docs)
PLATEGA_PAYMENT_METHOD=2
# CryptoBot (Crypto Pay) — USDT. Webhook: {APP_URL}/api/webhooks/cryptobot. Testnet: set CRYPTOBOT_API_BASE from @CryptoTestnetBot.
CRYPTOBOT_TOKEN=
CRYPTOBOT_API_BASE=
# xRocket Pay — USDT. Webhook: {APP_URL}/api/webhooks/xrocket. Test on testnet first (see server/providers/xrocket.mjs).
XROCKET_API_KEY=
XROCKET_WEBHOOK_SECRET=
XROCKET_API_BASE=
